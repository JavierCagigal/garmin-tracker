# Copia este fichero a .env y rellena tus credenciales reales.
# .env NUNCA se sube a git (ver .gitignore).

GARMIN_EMAIL=tu_email@ejemplo.com
GARMIN_PASSWORD=tu_password

# Dónde se guarda la sesión OAuth ya autenticada (tokens), para no tener que
# volver a meter usuario/contraseña (ni MFA) en cada ejecución.
GARMIN_TOKENSTORE=~/.garminconnect

# Ruta a la caché SQLite de actividades (se crea sola si no existe).
GARMIN_DB_PATH=./data/garmin_cache.db

# Ruta al Excel de salida.
GARMIN_EXCEL_PATH=./output/entrenamientos.xlsx
