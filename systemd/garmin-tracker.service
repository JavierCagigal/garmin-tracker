[Unit]
Description=Sincroniza actividades de Garmin Connect y regenera el Excel de entrenamientos
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/garmin-tracker
ExecStart=%h/garmin-tracker/.venv/bin/python %h/garmin-tracker/scripts/sync.py
ExecStart=%h/garmin-tracker/.venv/bin/python %h/garmin-tracker/scripts/generate_excel.py

# Timeout generoso: una primera sincronización con mucho histórico y
# reintentos con backoff puede tardar varios minutos.
TimeoutStartSec=1800
